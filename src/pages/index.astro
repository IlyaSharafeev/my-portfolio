---
import ThemeToggle from '../components/ThemeToggle.vue';
import { profile, contacts, experience, projects, stack, education } from '../data';

const title = `${profile.name} — ${profile.role} (React, Vue, Angular, TypeScript)`;
const description = `${profile.role}: ${profile.stackLine}. ${profile.location}. ${profile.availability}.`;
const year = new Date().getFullYear();
const ext = { target: '_blank', rel: 'noopener noreferrer' };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/photo.jpg', Astro.site)} />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        const dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      } catch {}
    </script>
  </head>
  <body class="bg-white font-sans text-zinc-800 antialiased dark:bg-zinc-950 dark:text-zinc-200">
    <header class="sticky top-0 z-10 border-b border-zinc-200 bg-white/85 backdrop-blur dark:border-zinc-800 dark:bg-zinc-950/85">
      <nav class="mx-auto flex max-w-4xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
        <a href="#top" class="font-semibold text-zinc-900 dark:text-white">IS</a>
        <div class="flex items-center gap-4 text-sm sm:gap-6">
          <a href="#experience" class="hidden hover:text-zinc-950 sm:inline dark:hover:text-white">Experience</a>
          <a href="#projects" class="hidden hover:text-zinc-950 sm:inline dark:hover:text-white">Projects</a>
          <a href="#stack" class="hidden hover:text-zinc-950 sm:inline dark:hover:text-white">Stack</a>
          <a href="#contact" class="hover:text-zinc-950 dark:hover:text-white">Contact</a>
          <ThemeToggle client:load />
        </div>
      </nav>
    </header>

    <main id="top" class="mx-auto max-w-4xl px-4 sm:px-6">
      <section class="flex flex-col gap-8 py-14 sm:flex-row sm:items-center sm:py-20">
        <img
          src="/photo.jpg"
          alt={profile.name}
          width="160"
          height="160"
          class="h-32 w-32 shrink-0 rounded-full object-cover ring-1 ring-zinc-200 sm:h-40 sm:w-40 dark:ring-zinc-800"
        />
        <div>
          <h1 class="text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl dark:text-white">{profile.name}</h1>
          <p class="mt-2 text-lg font-medium text-blue-700 dark:text-blue-400">{profile.role} — {profile.stackLine}</p>
          <p class="mt-4 max-w-2xl leading-relaxed">{profile.summary}</p>
          <p class="mt-3 text-sm text-zinc-500 dark:text-zinc-400">{profile.location} · {profile.availability}</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href={profile.cv} {...ext} class="rounded-lg bg-zinc-900 px-4 py-2 text-sm font-medium text-white hover:bg-zinc-700 dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-200">Download CV</a>
            <a href="#contact" class="rounded-lg border border-zinc-300 px-4 py-2 text-sm font-medium hover:border-zinc-500 dark:border-zinc-700 dark:hover:border-zinc-400">Contact me</a>
          </div>
        </div>
      </section>

      <section id="experience" class="scroll-mt-20 border-t border-zinc-200 py-12 dark:border-zinc-800">
        <h2 class="text-2xl font-semibold text-zinc-950 dark:text-white">Experience</h2>
        <ol class="mt-8 space-y-10">
          {experience.map((job) => (
            <li class="grid gap-2 sm:grid-cols-[11rem_1fr] sm:gap-6">
              <p class="text-sm text-zinc-500 dark:text-zinc-400">{job.period}</p>
              <div>
                <h3 class="font-semibold text-zinc-950 dark:text-white">
                  {job.company} <span class="font-normal text-zinc-500 dark:text-zinc-400">· {job.role}</span>
                </h3>
                <p class="mt-2 leading-relaxed">{job.text}</p>
                {job.links && (
                  <p class="mt-2 flex flex-wrap gap-x-3 text-sm">
                    <span>Live:</span>
                    {job.links.map((l) => (
                      <a href={l.href} {...ext} class="text-blue-700 underline-offset-2 hover:underline dark:text-blue-400">{l.label}</a>
                    ))}
                  </p>
                )}
                <ul class="mt-3 flex flex-wrap gap-2">
                  {job.stack.map((s) => (
                    <li class="rounded-md bg-zinc-100 px-2 py-0.5 text-xs text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">{s}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section id="projects" class="scroll-mt-20 border-t border-zinc-200 py-12 dark:border-zinc-800">
        <h2 class="text-2xl font-semibold text-zinc-950 dark:text-white">Projects</h2>
        <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">Commercial code is private, so these are public side projects and test assignments.</p>
        <div class="mt-8 grid gap-5 sm:grid-cols-2">
          {projects.map((p) => (
            <article class="flex flex-col rounded-xl border border-zinc-200 p-5 dark:border-zinc-800">
              <div class="flex items-baseline justify-between gap-3">
                <h3 class="font-semibold text-zinc-950 dark:text-white">{p.name}</h3>
                {p.note && <span class="shrink-0 text-xs text-zinc-500 dark:text-zinc-400">{p.note}</span>}
              </div>
              <p class="mt-2 flex-1 leading-relaxed">{p.text}</p>
              <ul class="mt-3 flex flex-wrap gap-2">
                {p.stack.map((s) => (
                  <li class="rounded-md bg-zinc-100 px-2 py-0.5 text-xs text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">{s}</li>
                ))}
              </ul>
              <div class="mt-4 flex gap-4 text-sm font-medium">
                {p.demo && <a href={p.demo} {...ext} class="text-blue-700 hover:underline dark:text-blue-400">Live demo</a>}
                <a href={p.code} {...ext} class="text-blue-700 hover:underline dark:text-blue-400">Code</a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="stack" class="scroll-mt-20 border-t border-zinc-200 py-12 dark:border-zinc-800">
        <h2 class="text-2xl font-semibold text-zinc-950 dark:text-white">Stack</h2>
        <dl class="mt-8 space-y-4">
          {stack.map((g) => (
            <div class="grid gap-1 sm:grid-cols-[11rem_1fr] sm:gap-6">
              <dt class="font-medium text-zinc-950 dark:text-white">{g.group}</dt>
              <dd class="leading-relaxed">{g.items.join(' · ')}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section class="border-t border-zinc-200 py-12 dark:border-zinc-800">
        <h2 class="text-2xl font-semibold text-zinc-950 dark:text-white">Education &amp; languages</h2>
        <p class="mt-6">{education.degree} — {education.school}, {education.year}</p>
        <p class="mt-2">{education.languages.join(' · ')}</p>
      </section>

      <section id="contact" class="scroll-mt-20 border-t border-zinc-200 py-12 dark:border-zinc-800">
        <h2 class="text-2xl font-semibold text-zinc-950 dark:text-white">Contact</h2>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {contacts.map((c) => (
            <li>
              <a href={c.href} {...ext} class="flex items-center justify-between rounded-lg border border-zinc-200 px-4 py-3 hover:border-zinc-400 dark:border-zinc-800 dark:hover:border-zinc-600">
                <span class="font-medium text-zinc-950 dark:text-white">{c.label}</span>
                <span class="truncate pl-4 text-sm text-zinc-500 dark:text-zinc-400">{c.value}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </main>

    <footer class="border-t border-zinc-200 py-8 text-center text-sm text-zinc-500 dark:border-zinc-800 dark:text-zinc-400">
      © {year} {profile.name}
    </footer>
  </body>
</html>
